{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ErpDb": "Host=localhost;Port=5433;Database=erp_simulator;Username=erp;Password=erp"
  },
  "Simulator": {
    "Seed": 42,
    "Rates": {
      "Success": 60,
      "Busy": 15,
      "ServerError": 10,
      "SaveThenError": 5,
      "LateResponse": 10
    },
    "LateResponseDelaySeconds": 30,
    "RetryAfterMinSeconds": 5,
    "RetryAfterMaxSeconds": 30,
    "RetryAfterFormat": "Seconds",
    // Aynı fatura numarasıyla gelen ikinci isteğin yeni kayıt açıp açmayacağı. Bizim seçimimiz (Gün 3), görev istemiyor.
    // false (varsayılan): her POST yeni kayıt açar; Gün 1'deki "aynı fatura iki kez -> iki kayıt" davranışı.
    // true: numara zaten kayıtlıysa yeniden kaydedilmez; içerik aynıysa mevcut referansla 202, farklıysa 409 döner.
    //       Fatura Servisi'nin kendi başına kesin önleyemediği durumu (ERP kaydı çok geç tamamlarsa çift kayıt) kapatır.
    "IdempotentInvoices": false
  },
  // Simülatörün Fatura Servisi'ne gönderdiği haberler (Gün 4). Hepsi zorunlu; eksik ya da kurala aykırıysa simülatör açılmaz.
  // Kaydedilen her fatura için önce invoice.received, sonra invoice.approved ya da invoice.rejected gönderilir.
  "Webhooks": {
    // Fatura Servisi'nin haber adresi. Görev: ayar dosyasından okunacak. docker compose içinde ortam değişkeniyle
    // http://invoice-service:8080/api/v1/erp-webhooks olarak değiştirilir.
    "TargetUrl": "http://localhost:5090/api/v1/erp-webhooks",
    // İmza (HMAC-SHA256) gizli anahtarı. Fatura Servisi'nin ayar dosyasındaki ErpWebhooks:Secret ile aynı olmalı.
    // En az 32 bayt. Bu değer yalnızca yerel geliştirme içindir.
    "Secret": "dev-only-erp-webhook-secret-do-not-use-in-production",
    // Servis bu kadar saniye içinde 2xx dönmezse gönderim başarısız sayılır. Görev: 5.
    "TimeoutSeconds": 5,
    // Başarısız gönderimden sonraki bekleme süreleri, saniye; eleman sayısı = en fazla tekrar sayısı.
    // Görev: 5, 10, 20, 40, 80 (ilk gönderim + en fazla 5 tekrar).
    "RetryDelaysSeconds": [ 5, 10, 20, 40, 80 ],
    // invoice.received, fatura kaydedildikten bu aralıkta rastgele bir süre sonra gönderilir. Görev: 2-10 sn.
    "FirstEventMinSeconds": 2,
    "FirstEventMaxSeconds": 10,
    // Karar haberi, invoice.received'dan bu aralıkta rastgele bir süre sonra gönderilir. Görev: 2-20 sn.
    "SecondEventMinSeconds": 2,
    "SecondEventMaxSeconds": 20,
    // Kararın onay olma oranı, yüzde; kalanı red. Görev: %80 onay, %20 red.
    "ApprovalRate": 80,
    // Red haberindeki sebep bunlardan rastgele biri olur. Bizim seçimimiz.
    "RejectReasons": [ "Vergi numarası geçersiz", "Tutar sipariş ile uyuşmuyor", "Müşteri kaydı bulunamadı", "Mükerrer fatura" ],
    // Aynı anda en fazla kaç haber gönderilir. Bizim seçimimiz: 20.
    "MaxConcurrentSends": 20,
    // Zamanı gelen haberlere kaç milisaniyede bir bakılır. Bizim seçimimiz: 200.
    "PollMilliseconds": 200
  }
}
