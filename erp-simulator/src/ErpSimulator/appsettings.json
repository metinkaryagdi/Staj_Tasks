{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ErpDb": "Host=localhost;Port=5433;Database=erp_simulator;Username=erp;Password=erp"
  },
  "Simulator": {
    "Seed": 42,
    "Rates": {
      "Success": 60,
      "Busy": 15,
      "ServerError": 10,
      "SaveThenError": 5,
      "LateResponse": 10
    },
    "LateResponseDelaySeconds": 30,
    "RetryAfterMinSeconds": 5,
    "RetryAfterMaxSeconds": 30,
    "RetryAfterFormat": "Seconds"
  }
}
