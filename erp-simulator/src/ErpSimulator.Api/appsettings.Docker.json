{
  // docker compose içinde çalışırken appsettings.json'ın üzerine okunur (ASPNETCORE_ENVIRONMENT=Docker).
  // Yalnızca container'da farklı olan değerler burada; geri kalan her ayar appsettings.json'dan gelir.
  // Metriklerin ve izlerin gönderildiği OpenTelemetry Collector (OTLP, gRPC), compose ağındaki adıyla.
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://otel-collector:4317",
  "ConnectionStrings": {
    // Simülatörün kendi veritabanı: compose'daki erp-db container'ı. Kullanıcı/şifre docker-compose.yml'deki
    // POSTGRES_USER/POSTGRES_PASSWORD ile aynı olmalı.
    "ErpDb": "Host=erp-db;Database=erp_simulator;Username=erp;Password=erp;GSS Encryption Mode=Disable"
  },
  "Webhooks": {
    // Fatura Servisi'nin haber adresi, compose ağındaki adıyla (bilgisayardan çalışırken appsettings.json'daki
    // localhost:5090).
    "TargetUrl": "http://invoice-service:8080/api/v1/erp-webhooks"
  }
}
