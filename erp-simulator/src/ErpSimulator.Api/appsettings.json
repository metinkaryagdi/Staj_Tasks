{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ErpDb": "Host=localhost;Port=5433;Database=erp_simulator;Username=erp;Password=erp"
  },
  "Simulator": {
    // Davranış dizisini sabitler: aynı seed ve aynı istek sırasıyla aynı davranışlar çıkar, testler tekrarlanabilir olur.
    "Seed": 42,
    // Her POST'un davranış olasılığı, yüzde; toplamı 100 olmak zorunda. Success: 202 ve kayıt; Busy: 429; ServerError: 500, kayıt yok;
    // SaveThenError: 500 ama kayıt var; LateResponse: kayıt var, 202 gecikmeli. Servisin hata yollarını sınamak için çoğu istek sorunsuz değildir.
    "Rates": {
      "Success": 60,
      "Busy": 15,
      "ServerError": 10,
      "SaveThenError": 5,
      "LateResponse": 10
    },
    // LateResponse'ta cevabın gecikme süresi, saniye; servisin zaman aşımından (10 sn) uzun olmalı ki servis cevabı beklemeden vazgeçsin, ERP kaydı çoktan yapmış olsun.
    "LateResponseDelaySeconds": 30,
    // Busy (429) cevabındaki Retry-After bu aralıkta (saniye) rastgele seçilir.
    "RetryAfterMinSeconds": 5,
    "RetryAfterMaxSeconds": 30,
    // Retry-After başlığının biçimi: Seconds (saniye sayısı) ya da HttpDate (tarih); servisin ikisini de anlaması gerekir.
    "RetryAfterFormat": "Seconds",
    // Aynı fatura numarasıyla gelen ikinci isteğin yeni kayıt açıp açmayacağı; açıksa ERP, servisin tek başına önleyemediği çift kaydı alıcı tarafta kapatır.
    // false: her POST yeni kayıt açar. true: numara kayıtlıysa yeniden kaydedilmez;
    // içerik aynıysa mevcut referansla 202, farklıysa 409 döner.
    "IdempotentInvoices": false
  },
  // Simülatörün Fatura Servisi'ne gönderdiği haberler. Hepsi zorunlu; kurala aykırıysa simülatör açılmaz.
  // Kaydedilen her fatura için önce invoice.received, sonra invoice.approved ya da invoice.rejected gönderilir.
  "Webhooks": {
    // false: haber planlanmaz; yalnızca kendi haberini elle gönderen test script'leri için (simülatörün haberleri araya girmesin).
    "Enabled": true,
    // Fatura Servisi'nin haber adresi. docker compose'da ortam değişkeniyle http://invoice-service:8080/api/v1/erp-webhooks olur.
    "TargetUrl": "http://localhost:5090/api/v1/erp-webhooks",
    // İmza (HMAC-SHA256) anahtarı; Fatura Servisi'nin ErpWebhooks:Secret'ı ile aynı ve en az 32 bayt olmalı. Yalnızca yerel geliştirme için.
    "Secret": "dev-only-erp-webhook-secret-do-not-use-in-production",
    // Servis bu sürede 2xx dönmezse gönderim başarısız sayılır, saniye; servisin habere cevap verme süresiyle (5 sn) aynıdır.
    "TimeoutSeconds": 5,
    // Başarısız gönderimin başlangıcından sonrakinin başlangıcına kadar geçen süreler, saniye; eleman sayısı = en fazla tekrar.
    // Her tekrar bir öncekinin iki katı bekler; geçici bir kesinti toparlanana kadar servis sık sık yüklenmez.
    "RetryDelaysSeconds": [ 5, 10, 20, 40, 80 ],
    // invoice.received, kayıttan bu aralıkta (saniye) rastgele bir süre sonra gönderilir; ERP haberi kayıttan hemen sonra değil, işledikten sonra gönderir.
    "FirstEventMinSeconds": 2,
    "FirstEventMaxSeconds": 10,
    // Karar haberi, invoice.received'dan bu aralıkta (saniye) rastgele bir süre sonra gönderilir; kararın verilmesi biraz sürer.
    "SecondEventMinSeconds": 2,
    "SecondEventMaxSeconds": 20,
    // Kararın onay olma oranı, yüzde; kalanı red. Çoğu fatura onaylanır, reddedilenler reject_reason yolunu sınar.
    "ApprovalRate": 80,
    // Red haberindeki sebep bunlardan rastgele biri olur.
    "RejectReasons": [ "Vergi numarası geçersiz", "Tutar sipariş ile uyuşmuyor", "Müşteri kaydı bulunamadı", "Mükerrer fatura" ],
    // Aynı anda en fazla kaç haber gönderilir; servisi aynı anda çok istekle yüklememek için.
    "MaxConcurrentSends": 20,
    // Gönderici iki bakış arasında en fazla bu kadar bekler, ms; haberler en erken 2 sn sonraya planlandığı için zamanında görülür.
    "PollMilliseconds": 200,
    // Bilerek çıkarılan sorunlar, yüzde; oranlar birbirinden bağımsız. Hepsi 0 ise haberler sorunsuz gider.
    "Problems": {
      // Haber başına: aynı haber aynı event_id ile ikinci kez gönderilir (0-2 sn sonra); servisin tekrarı yalnızca saymasını sınar.
      "DuplicateRate": 10,
      // Fatura başına: karar haberi invoice.received'dan önce gönderilir (yalnızca gönderim zamanları yer değiştirir).
      // Karar kayıpsa uygulanmaz.
      "OrderMixRate": 15,
      // Fatura başına: karar haberi hiç gönderilmez (webhook_deliveries'te Skipped kalır); bu faturaları yalnızca mutabakat düzeltebilir.
      "LostDecisionRate": 5,
      // Fatura başına: yanlış anahtarla imzalı, kendi event_id'li bir karar haberi gönderilir.
      // 4xx'te tekrar gönderilmez; 5xx ve cevapsızlıkta gönderilir.
      "FakeRate": 5,
      // Fatura başına: teslim edilmiş bir haber, ReplayAgeSeconds eski zaman damgası ve geçerli imzayla yeniden gönderilir.
      // 4xx'te tekrar gönderilmez; 5xx ve cevapsızlıkta gönderilir.
      "ReplayRate": 5,
      // Eski haberin zaman damgası kaç saniye önce; servisin zaman toleransını (300 sn) aşacak kadar eski olmalı.
      "ReplayAgeSeconds": 600
    }
  }
}
