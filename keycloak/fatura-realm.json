{
  "realm": "fatura",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "fatura-izleyici", "description": "Faturaları ve mutabakatı okur" },
      { "name": "fatura-operatoru", "description": "Okur ve müdahale eder: yeniden gönderme, toplu yeniden gönderme, mutabakat başlatma, elle takip" },
      { "name": "fatura-olusturucu", "description": "Fatura oluşturur (POST /api/v1/invoices); yalnızca sipariş sistemi" }
    ]
  },
  "users": [
    {
      "username": "izleyici",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Izleyici",
      "email": "izleyici@fatura.test",
      "credentials": [ { "type": "password", "value": "${TEST_IZLEYICI_PASSWORD}", "temporary": false } ],
      "realmRoles": [ "fatura-izleyici" ]
    },
    {
      "username": "operator",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Operator",
      "email": "operator@fatura.test",
      "credentials": [ { "type": "password", "value": "${TEST_OPERATOR_PASSWORD}", "temporary": false } ],
      "realmRoles": [ "fatura-operatoru" ]
    },
    {
      "username": "rolsuz",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Rolsuz",
      "email": "rolsuz@fatura.test",
      "credentials": [ { "type": "password", "value": "${TEST_ROLSUZ_PASSWORD}", "temporary": false } ],
      "realmRoles": []
    },
    {
      "username": "service-account-siparis-sistemi",
      "enabled": true,
      "serviceAccountClientId": "siparis-sistemi",
      "realmRoles": [ "fatura-olusturucu" ]
    }
  ],
  "clients": [
    {
      "clientId": "operasyon-ekrani",
      "description": "Operasyon ekranı: tarayıcıda çalışır, secret saklayamaz (public client); yalnızca Authorization Code + PKCE (S256), şifreyle token yok",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "http://localhost:5100/*" ],
      "webOrigins": [ "http://localhost:5100" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5100/*"
      },
      "protocolMappers": [
        {
          "name": "fatura-servisi-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "fatura-servisi",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "siparis-sistemi",
      "description": "Faturaları oluşturan sipariş sistemi: kullanıcı değil, servis (client credentials)",
      "publicClient": false,
      "secret": "${ORDER_SYSTEM_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "fatura-servisi-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "fatura-servisi",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}