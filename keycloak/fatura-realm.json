      "credentials": [ { "type": "password", "value": "operator123", "temporary": false } ],
      "realmRoles": [ "fatura-operatoru" ]
    },
    {
      "username": "rolsuz",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Rolsuz",
      "email": "rolsuz@fatura.test",
      "credentials": [ { "type": "password", "value": "rolsuz123", "temporary": false } ],
      "realmRoles": []
    },
    {
      "username": "service-account-siparis-sistemi",
      "enabled": true,
      "serviceAccountClientId": "siparis-sistemi",
