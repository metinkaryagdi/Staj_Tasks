          "expr": "sum(increase(reconciliation_duration_seconds_sum[1h])) / sum(increase(reconciliation_duration_seconds_count[1h]))",
          "legendFormat": "ortalama süre",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Bulgular",
