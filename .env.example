# docker compose'un okuduğu şifre ve secret'lar. Bu dosya örnektir: .env adıyla kopyalanır ve her değere rastgele bir değer
# yazılır. .env git'e girmez (.gitignore); repoda hiçbir şifre ya da secret tutulmaz. Değeri boş olan bir satır varken
# docker compose açılmaz ve hangi değerin eksik olduğunu yazar.
# Rastgele değer: openssl rand -hex 24 (Git for Windows ile gelir) ya da bir şifre üreticisi. Değerlerde ; ve boşluk olmasın
# (veritabanı şifreleri bağlantı dizesine yazılır).

# Keycloak'ın yönetici hesabı (kullanıcı adı admin). Yönetim konsolu http://localhost:8080.
KEYCLOAK_ADMIN_PASSWORD=
# ERP Simülatörü'nün ve Fatura Servisi'nin PostgreSQL şifreleri (kullanıcılar erp ve invoice).
ERP_DB_PASSWORD=
INVOICE_DB_PASSWORD=
# Uygulamaların bağlandığı, yalnız satır okuyup yazabilen veritabanı kullanıcılarının şifreleri (erp_app, invoice_app).
# Migration adımı (erp-migrate, invoice-migrate) kullanıcıyı her açılışta bu şifreyle günceller.
ERP_DB_APP_PASSWORD=
INVOICE_DB_APP_PASSWORD=
# ERP haberlerinin HMAC-SHA256 imza anahtarı; simülatör imzalar, Fatura Servisi doğrular. En az 32 karakter.
ERP_WEBHOOK_SECRET=
# Sipariş sisteminin (siparis-sistemi client'ı) Keycloak'tan token alırken kullandığı secret.
ORDER_SYSTEM_CLIENT_SECRET=
# fatura realm'indeki test kullanıcılarının şifreleri (izleyici, operator, rolsuz); realm içe aktarılırken verilir. Realm'in
# şifre politikasına uymalı (en az 12 karakter, kullanıcı adı ya da e-posta olamaz); uymazsa Keycloak açılmaz.
TEST_IZLEYICI_PASSWORD=
TEST_OPERATOR_PASSWORD=
TEST_ROLSUZ_PASSWORD=
# Grafana'nın yönetici hesabı (kullanıcı adı admin). Pano http://localhost:3000.
GRAFANA_ADMIN_PASSWORD=
# Prometheus, Alertmanager ve Jaeger'ın önündeki girişin (oauth2-proxy) Keycloak client secret'ı (izleme-girisi) ve oturum
# çerezini şifreleyen anahtar. Anahtar tam 32 karakter olmalı: openssl rand -hex 16.
MONITORING_CLIENT_SECRET=
MONITORING_COOKIE_SECRET=
