{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "InvoiceDb": "Host=localhost;Port=5434;Database=invoice_service;Username=invoice;Password=invoice"
  },
  // ERP Simülatörü'ne bağlantı. İki değer de zorunlu; eksik ya da geçersizse servis açılmaz.
  "Erp": {
    // Simülatörün adresi. docker compose içinde ortam değişkeniyle http://erp-simulator:8080 olarak değiştirilir.
    "BaseUrl": "http://localhost:5080",
    // Simülatöre yapılan her isteğin (POST ve "bu fatura sende var mı?" sorusu) zaman aşımı, saniye.
    // Görev: 10 saniye (Gün 2'den beri; HttpClient'ın varsayılanı 100 sn).
    "TimeoutSeconds": 10
  },
  // Arka plan worker'ı ve tekrar deneme kuralları. Hepsi zorunlu; eksik ya da kurala aykırıysa servis açılmaz ve nedenini yazar.
  // Değiştirdikten sonra servisi yeniden derleyip başlatın (docker compose up -d --build invoice-service).
  "Outbox": {
    // Bir servis kopyasının aynı anda en fazla kaç gönderim yaptığı. Görev: 10 ("Worker aynı anda en fazla 10 gönderim").
    // Kopya başına uygulanır: iki kopya çalışırken toplamda 2 katı olabilir.
    "MaxConcurrentSends": 10,
    // Bir faturanın en fazla kaç deneme hakkı olduğu. Görev: 10. Son deneme de başarısız olursa, faturayı Başarısız
    // yapmadan önce simülatöre bir kez "bu fatura sende var mı?" diye sorulur (gönderim yapılmaz); bu da bu sayıya bağlıdır.
    // Resend deneme sayısını sıfırlar, fatura bu kadar hakkı yeniden alır.
    "MaxAttempts": 10,
    // 500, zaman aşımı ve simülatöre ulaşılamama durumundaki bekleme (2, 4, 8 ... sn) en fazla bu kadar olur, jitter dahil.
    // Görev: 60 saniye. 429'daki Retry-After beklemesine uygulanmaz (simülatör ne kadar derse o kadar beklenir).
    "MaxBackoffSeconds": 60,
    // Her beklemeye eklenen rastgele sapmanın (jitter) üst sınırı, milisaniye: 0 ile bu değer arasında rastgele.
    // Görev "rastgele küçük bir sapma" diyor; 1 sn bizim seçimimiz. Amaç: birlikte başarısız olan faturalar
    // (ör. simülatör kapalıyken) hep aynı anda tekrar denemesin.
    "MaxJitterMilliseconds": 1000,
    // Worker bir outbox kaydını aldığında o kayıt bu kadar saniye onundur (locked_until). Servis gönderim sırasında
    // öldürülürse kayıt bu süre dolunca başka bir worker tarafından yeniden alınır. Bizim seçimimiz: 60.
    // Bir deneme en uzun "sor + gönder + son kez sor" = 3 x TimeoutSeconds sürer; kilit bundan uzun olmalı,
    // yoksa başka bir worker gönderim sürerken aynı kaydı alabilir (çift kayıt riski). Kısaysa servis açılmaz.
    "LockSeconds": 60,
    // Kuyrukta zamanı gelmiş kayıt yoksa worker'ın tekrar bakmadan önce beklediği süre, milisaniye. Bizim seçimimiz: 250.
    // Kısa olması, Retry-After ya da backoff süresi dolunca denemenin gecikmeden başlamasını sağlar.
    "IdleDelayMilliseconds": 250
  },
  // ERP'den gelen haberler (POST /api/v1/erp-webhooks). Hepsi zorunlu; eksik ya da kurala aykırıysa servis açılmaz.
  "ErpWebhooks": {
    // Haber imzasının (HMAC-SHA256) gizli anahtarı. Simülatörün ayar dosyasındaki ErpWebhooks:Secret ile aynı olmalı,
    // yoksa bütün haberler 401 alır. En az 32 bayt. Bu değer yalnızca yerel geliştirme içindir; gerçek ortamda
    // ayar dosyasına değil ortam değişkenine / gizli anahtar deposuna konur.
    "Secret": "dev-only-erp-webhook-secret-do-not-use-in-production",
    // X-Erp-Timestamp şu andan en fazla bu kadar saniye eski olabilir. Görev: 5 dakika (300). Daha eski haber 401 alır.
    // Bizim eklememiz: aynı sınır ileri tarihli damgaya da uygulanır (300 sn'den fazla ileri tarihli haber de 401).
    "ToleranceSeconds": 300,
    // Haber gövdesinin en büyük boyutu, bayt. Daha büyüğü imzası hesaplanmadan 413 alır. Bizim seçimimiz: 65536 (64 KB);
    // simülatörün haberleri birkaç yüz bayt.
    "MaxBodyBytes": 65536,
    // Görev: servis her habere 5 saniye içinde cevap verecek. Haber bu süre içinde kaydedilip işlenemezse servis 503
    // döner ve simülatör haberi tekrar gönderir (iş geç de olsa tamamlandıysa tekrar gelen haber tekrar sayılır, iki kez
    // işlenmez). 5000'den küçük olmak zorunda; 4000 ms ile cevap ve ağ için 1 sn pay kalır.
    "ResponseBudgetMilliseconds": 4000,
    // Haberin, faturanın satır kilidini en fazla bekleyeceği süre (PostgreSQL lock_timeout). Aşılırsa 503.
    // ResponseBudgetMilliseconds'tan küçük olmak zorunda. Bizim seçimimiz: 2000.
    "LockTimeoutMilliseconds": 2000
  }
}
