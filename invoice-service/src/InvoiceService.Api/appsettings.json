{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "InvoiceDb": "Host=localhost;Port=5434;Database=invoice_service;Username=invoice;Password=invoice"
  },
  // ERP Simülatörü'ne bağlantı. İki değer de zorunlu; eksik ya da geçersizse servis açılmaz.
  "Erp": {
    // Simülatörün adresi. docker compose'da ortam değişkeniyle http://erp-simulator:8080 olur.
    "BaseUrl": "http://localhost:5080",
    // Simülatöre yapılan her isteğin (POST ve "bu fatura sende var mı?" sorusu) zaman aşımı, saniye.
    // Cevap vermeyen bir ERP worker'ı ve kayıt kilidini uzun süre tutmasın.
    "TimeoutSeconds": 10
  },
  // Arka plan worker'ı ve tekrar deneme kuralları. Hepsi zorunlu; kurala aykırıysa servis açılmaz.
  // Değiştirdikten sonra servisi yeniden derleyip başlatın (docker compose up -d --build invoice-service).
  "Outbox": {
    // Bir servis kopyasının aynı anda yaptığı en fazla gönderim. Hızı SendsPerSecond belirler; bu yalnızca üst sınır.
    // SendsPerSecond'a ulaşmaya yetmeli: geç cevap veren bir istek zaman aşımına kadar (Erp:TimeoutSeconds) bir yer
    // tutar; 10 ile servis saniyede ~7 gönderimde kalıyordu. İki kopya çalışırken toplam bunun iki katı olabilir.
    "MaxConcurrentSends": 40,
    // Bütün servis kopyalarının birlikte saniyede yaptığı en fazla fatura gönderimi (POST). ERP saniyede 20 istek kabul
    // ediyor; ağdaki küçük gecikme farkları iki isteği aynı saniyeye düşürmesin diye biraz altında. Sıralar
    // veritabanındaki tek satırda tutulur, kopya sayısından bağımsızdır. "ERP'de var mı?" sorguları (GET) bu sınıra
    // girmez; ERP yalnızca faturayı kabul eden endpoint'i sınırlıyor.
    "SendsPerSecond": 18,
    // Bir faturanın en fazla kaç kez denendiği; hepsi başarısızsa Başarısız olur, yalnızca resend yeniden kuyruğa
    // alır ve hakkı sıfırlar. Başarısız yazmadan önce ERP'ye bir kez sorulur (ERP kaydetmiş olabilir).
    "MaxAttempts": 10,
    // 500, zaman aşımı ve ulaşılamamada bekleme (2, 4, 8 ... sn) jitter dahil bunu aşmaz; tek bir denemenin
    // ertelenmesi sınırlı kalır. 429'daki Retry-After beklemesine uygulanmaz.
    "MaxBackoffSeconds": 60,
    // Beklemeye eklenen rastgele sapmanın üst sınırı, ms; birlikte başarısız olanlar aynı anda denenip toparlanan
    // ERP'yi tek dalgada yüklemesin.
    "MaxJitterMilliseconds": 1000,
    // Alınan kaydın bu worker'a ait olduğu süre, saniye; dolunca başka worker alabilir. Bir deneme (sor, gönder, son
    // kez sor) en çok 3 x Erp:TimeoutSeconds sürer; bundan uzun olmak zorunda, yoksa başka worker sürmekte olan kaydı
    // alırdı.
    "LockSeconds": 60,
    // Zamanı gelmiş kayıt yoksa worker'ın bir sonraki bakışa kadar beklediği süre, ms; kısa tutulur ki bekleme süresi
    // dolan deneme gecikmeden başlasın.
    "IdleDelayMilliseconds": 250
  },
  // ERP'den gelen haberler (POST /api/v1/erp-webhooks). Hepsi zorunlu; kurala aykırıysa servis açılmaz.
  "ErpWebhooks": {
    // İmza (HMAC-SHA256) anahtarı; simülatörün Webhooks:Secret'ı ile aynı ve en az 32 bayt olmalı.
    // Yalnızca yerel geliştirme için; gerçek ortamda ortam değişkeninden okunur.
    "Secret": "dev-only-erp-webhook-secret-do-not-use-in-production",
    // X-Erp-Timestamp en fazla bu kadar saniye eski ya da ileri tarihli olabilir; aksi 401. İmzalı bir haberin
    // sonradan tekrar gönderilmesini (replay) sınırlar.
    "ToleranceSeconds": 300,
    // Haber gövdesinin en büyük boyutu, bayt; aşılırsa imza hesaplanmadan 413. Haberler birkaç yüz bayttır, 64 KB bol
    // paydır.
    "MaxBodyBytes": 65536,
    // Habere en geç bu kadar ms içinde cevap verilir; yetişmezse 503 ve simülatör tekrar gönderir. Servis her habere
    // 5 sn içinde cevap vermelidir, bu yüzden 5000'den küçük olmak zorunda (4000: cevap ve ağ için 1 sn pay).
    "ResponseBudgetMilliseconds": 4000,
    // Faturanın satır kilidi için en fazla bekleme, ms; aşılırsa 503. Cevap süresi dolmadan vazgeçebilmek için
    // ResponseBudgetMilliseconds'tan küçük olmak zorunda.
    "LockTimeoutMilliseconds": 2000
  },
  // Operasyon ekranının adresi: ekran tarayıcıda çalışır ve bu servise başka bir adresten istek yapar; tarayıcı yalnızca
  // burada yazılı adreslerden açılmış sayfaların isteğine izin verir (CORS). Adres şema, sunucu ve porttan oluşur; sonunda
  // "/" ve yol olmaz, "*" yazılamaz. Ekran başka bir adresten açılacaksa buraya eklenir (docker compose'da ekran
  // http://localhost:5100'dür). Boşsa ya da geçersizse servis açılmaz.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5100" ]
  },
  // Mutabakat: servisin kayıtları ERP Simülatörü ile belirli aralıklarla karşılaştırılır. Hepsi zorunlu; kurala
  // aykırıysa servis açılmaz.
  "Reconciliation": {
    // İki çalışma arasındaki süre, dakika (en çok 10080, bir hafta); ilk çalışma servis açıldıktan bu kadar sonra
    // başlar. Sık çalışmak haberi yalnızca geç gelen faturaları da düzeltir; testlerde ortam değişkeniyle 1'e
    // çekilir.
    "IntervalMinutes": 60,
    // Karşılaştırmanın geriye bakacağı süre, saat (en çok 8760, bir yıl): bu sürede oluşan faturalar karşılaştırılır.
    // Kesinleşmemiş faturalar (Gönderildi, İşleme Alındı, Başarısız) yaşına bakılmadan kontrol edilir; uzun bir
    // kesintiden sonra takılı fatura pencerenin dışında kalmasın diye.
    "LookbackHours": 24,
    // Gönderildi ya da İşleme Alındı'da bundan uzun kalan faturanın kararı ERP'ye sorulur, dakika; haberin gelmesine
    // zaman tanımak için.
    "StuckAfterMinutes": 2,
    // Servisin tanımadığı faturaya ait bekleyen haber bundan eskiyse Yok Sayıldı olur, dakika; fatura bu sürede de
    // gelmediyse haber bekletilmez.
    "UnknownEventAfterMinutes": 60,
    // Takılı bir fatura bu kadar dakikadan uzun aynı durumdaysa ve ERP'ye sorulduğunda faturayı ilerletecek bir karar
    // yoksa "ERP Karar Vermedi" bulgusu raporlanır; ERP sessiz kaldıkça her çalışmada yeniden yazılır. StuckAfterMinutes'tan
    // küçük olamaz (yalnızca takılı faturalar sorulur).
    "NoDecisionAfterMinutes": 30,
    // ERP'nin "bende yok" dediği Başarısız fatura bu kadar saat yeniden sorulmaz (en çok 8760); fatura bu arada
    // değişirse (örn. yeniden gönderilirse) ilk çalışmada yine sorulur. ERP'nin hiç almadığı eski faturalar her
    // çalışmada boşuna sorulmasın diye.
    "NotFoundRecheckHours": 24
  }
}
